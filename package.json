{
  "name": "myuru",
  "version": "2.0.0-alpha.5",
  "description": "AI agent for your terminal. Read files, run commands, write code — with any LLM provider. BYO API key.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    }
  },
  "bin": {
    "myuru": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "node --test --import tsx src/**/*.test.ts",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "agents",
    "multi-agent",
    "orchestration",
    "llm",
    "typescript",
    "claude",
    "openai",
    "gemini",
    "mcp",
    "pipeline",
    "tracing",
    "observability",
    "provider-agnostic"
  ],
  "author": "Wittlesus",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wittlesus/myuru.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "ai": "^6.0.86",
    "commander": "^12.0.0",
    "nanoid": "^5.0.0",
    "zod": "^3.23.0"
  },
  "peerDependencies": {
    "@ai-sdk/anthropic": ">=3.0.0",
    "@ai-sdk/google": ">=3.0.0",
    "@ai-sdk/openai": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/anthropic": {
      "optional": true
    },
    "@ai-sdk/openai": {
      "optional": true
    },
    "@ai-sdk/google": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^3.0.0",
    "@ai-sdk/google": "^3.0.0",
    "@ai-sdk/openai": "^3.0.0",
    "@types/node": "^25.2.3",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0"
  }
}
